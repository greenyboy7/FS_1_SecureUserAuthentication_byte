### Register
POST http://localhost:5093/api/Auth/register
Content-Type: application/json

{
  "fullName": "Patrick Mueti",
  "email": "patrick.test@example.com",
  "userName": "patrick.test@example.com",
  "password": "Password123!"
}

### Login
POST http://localhost:5093/api/Auth/login
Content-Type: application/json

{
  "email": "patrick.test@example.com",
  "password": "Password123!"
}

### Get current user
GET http://localhost:5093/api/Auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..l-AirQumz_yPWoT-EyOdD5-IdtB8blc6wBOClici0Ho

### Get all employees
GET http://localhost:5093/api/Employee
### Create employee
POST http://localhost:5093/api/Employee
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john@example.com",
  "phone": "0712345678",
  "salary": 50000,
  "department": "IT",
  "position": "Software Developer"
}

### Get employee by ID
GET http://localhost:5093/api/Employee/1
### Update employee
### Update employee
PUT http://localhost:5093/api/Employee/4
Content-Type: application/json

{
  "id": 4,
  "name": "John Updated",
  "email": "john.updated@example.com",
  "phone": "0798765432",
  "salary": 60000,
  "department": "Software Development",
  "position": "Senior Developer"
}
### Delete employee
DELETE http://localhost:5093/api/Employee/4
##### Make user admin
POST http://localhost:5093/api/Auth/make-admin?email=patrick.test@example.com

